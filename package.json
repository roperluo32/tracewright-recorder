{
  "name": "tracewright-recorder",
  "version": "0.1.0",
  "description": "A local browser extension that records user flows and exports Playwright tests.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:chrome": "wxt build -b chrome",
    "build:edge": "wxt build -b edge",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:chrome": "wxt zip -b chrome",
    "zip:edge": "wxt zip -b edge",
    "zip:firefox": "wxt zip -b firefox",
    "release:all": "rm -rf release && mkdir release && pnpm zip:chrome && pnpm zip:edge && pnpm zip:firefox && cp .output/*-chrome.zip .output/*-edge.zip .output/*-firefox.zip release/",
    "compile": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test tests/e2e/build-artifacts.spec.ts",
    "test:e2e:smoke": "TRACEWRIGHT_E2E_HOST_PERMISSIONS=1 pnpm build:chrome && TRACEWRIGHT_E2E_HOST_PERMISSIONS=1 playwright test tests/e2e/smoke-recorder.spec.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build:chrome && pnpm build:edge && pnpm build:firefox && pnpm test:e2e"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "@wxt-dev/module-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "webextension-polyfill": "latest",
    "wxt": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/chrome": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/webextension-polyfill": "latest",
    "@typescript-eslint/eslint-plugin": "latest",
    "@typescript-eslint/parser": "latest",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "latest",
    "eslint-plugin-react-hooks": "latest",
    "happy-dom": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  },
  "packageManager": "pnpm@10.14.0"
}
